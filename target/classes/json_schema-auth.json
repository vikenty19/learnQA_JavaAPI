{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "name", "email", "is_admin", "preferences"],
  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "is_admin": {
      "type": "boolean"
    },
    "preferences": {
      "type": "object",
      "required": ["lastfm_session_key"],
      "properties": {
        "lastfm_session_key": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}